<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
  <title>EduAI | Zamonaviy AI ta'lim platformasi</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    }

    /* Animatsiyalar */
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes float {
      0% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
      100% { transform: translateY(0px); }
    }
    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(79, 70, 229, 0.4); }
      70% { box-shadow: 0 0 0 15px rgba(79, 70, 229, 0); }
      100% { box-shadow: 0 0 0 0 rgba(79, 70, 229, 0); }
    }
    @keyframes shimmer {
      0% { background-position: -1000px 0; }
      100% { background-position: 1000px 0; }
    }
    @keyframes rotateSlow {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    @keyframes slideInLeft {
      from { opacity: 0; transform: translateX(-40px); }
      to { opacity: 1; transform: translateX(0); }
    }
    @keyframes slideInRight {
      from { opacity: 0; transform: translateX(40px); }
      to { opacity: 1; transform: translateX(0); }
    }
    @keyframes glowPulse {
      0% { text-shadow: 0 0 5px rgba(79,70,229,0.5); }
      100% { text-shadow: 0 0 20px rgba(79,70,229,0.8); }
    }

    body {
      background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
      min-height: 100vh;
      position: relative;
      overflow-x: hidden;
    }
    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: radial-gradient(circle at 20% 50%, rgba(79, 70, 229, 0.1) 0%, transparent 50%),
                  radial-gradient(circle at 80% 80%, rgba(6, 182, 212, 0.1) 0%, transparent 50%);
      pointer-events: none;
      z-index: 0;
    }

    /* Login sahifasi */
    .login-page {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      z-index: 2;
    }
    .login-card {
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(20px);
      border-radius: 56px;
      padding: 52px 48px;
      width: 460px;
      box-shadow: 0 40px 80px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(255,255,255,0.2);
      text-align: center;
      animation: fadeInUp 0.8s ease-out;
      transition: transform 0.3s;
    }
    .login-card:hover {
      transform: translateY(-5px);
    }
    .login-card h2 {
      background: linear-gradient(135deg, #4f46e5, #06b6d4);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      font-size: 32px;
      margin-bottom: 28px;
      animation: glowPulse 2s ease-in-out infinite alternate;
    }
    .login-card input {
      width: 100%;
      padding: 15px 20px;
      margin: 12px 0;
      border-radius: 60px;
      border: 2px solid #e2e8f0;
      font-size: 15px;
      transition: all 0.3s;
    }
    .login-card input:focus {
      border-color: #4f46e5;
      box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.2);
      outline: none;
    }
    .login-card button {
      width: 100%;
      padding: 15px;
      background: linear-gradient(135deg, #4f46e5, #06b6d4);
      border: none;
      border-radius: 60px;
      color: white;
      font-weight: bold;
      font-size: 16px;
      cursor: pointer;
      transition: all 0.3s;
      margin-top: 12px;
      position: relative;
      overflow: hidden;
    }
    .login-card button::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
      transition: left 0.5s;
    }
    .login-card button:hover::before {
      left: 100%;
    }
    .login-card button:hover {
      transform: scale(1.02);
      box-shadow: 0 10px 30px rgba(79, 70, 229, 0.4);
    }
    .demo-info {
      background: linear-gradient(135deg, #f1f5f9, #e2e8f0);
      padding: 14px;
      border-radius: 28px;
      margin-top: 24px;
      font-size: 13px;
      animation: slideInLeft 0.6s ease-out;
    }

    /* Dashboard umumiy */
    .dashboard-container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 24px 32px;
      position: relative;
      z-index: 2;
      animation: fadeInUp 0.5s ease-out;
    }
    .top-bar {
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(20px);
      border-radius: 80px;
      padding: 12px 32px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 40px;
      color: white;
      border: 1px solid rgba(255,255,255,0.1);
      animation: slideInRight 0.6s ease-out;
    }
    .logo {
      font-size: 28px;
      font-weight: 800;
      background: linear-gradient(135deg, #c084fc, #38bdf8);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      animation: float 3s ease-in-out infinite;
    }
    .user-area {
      display: flex;
      align-items: center;
      gap: 20px;
    }
    .avatar-icon {
      width: 48px;
      height: 48px;
      background: linear-gradient(145deg, #4f46e5, #06b6d4);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      animation: pulse 2s infinite;
    }
    .logout-btn {
      background: rgba(255,255,255,0.15);
      border: none;
      padding: 8px 24px;
      border-radius: 40px;
      color: white;
      cursor: pointer;
      transition: all 0.3s;
    }
    .logout-btn:hover {
      background: #ef4444;
      transform: scale(1.05);
    }

    /* Tablar */
    .tabs {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 32px;
    }
    .tab-btn {
      background: rgba(255,255,255,0.1);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,0.2);
      padding: 12px 32px;
      font-weight: 600;
      border-radius: 60px;
      cursor: pointer;
      transition: all 0.3s;
      color: #e2e8f0;
    }
    .tab-btn:hover {
      background: rgba(79, 70, 229, 0.5);
      transform: translateY(-2px);
    }
    .tab-btn.active {
      background: linear-gradient(135deg, #4f46e5, #06b6d4);
      color: white;
      box-shadow: 0 6px 20px rgba(79, 70, 229, 0.4);
    }

    /* Kartalar */
    .grid-2cols {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
      gap: 28px;
    }
    .glass-card {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(10px);
      border-radius: 36px;
      padding: 28px;
      transition: all 0.4s;
      border: 1px solid rgba(255,255,255,0.3);
      animation: fadeInUp 0.7s ease-out;
    }
    .glass-card:hover {
      transform: translateY(-8px) scale(1.01);
      box-shadow: 0 25px 40px rgba(0,0,0,0.2);
    }
    .glass-card h3 {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 24px;
      font-size: 22px;
      color: #1e293b;
      border-left: 5px solid #4f46e5;
      padding-left: 16px;
    }
    input, select, textarea {
      width: 100%;
      padding: 12px 18px;
      margin: 8px 0;
      border-radius: 32px;
      border: 2px solid #e2e8f0;
      transition: all 0.3s;
    }
    input:focus {
      border-color: #4f46e5;
      box-shadow: 0 0 0 3px rgba(79,70,229,0.2);
      outline: none;
    }
    button.primary {
      background: linear-gradient(135deg, #4f46e5, #06b6d4);
      border: none;
      padding: 12px 24px;
      border-radius: 60px;
      color: white;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s;
    }
    button.primary:hover {
      transform: scale(1.03);
      box-shadow: 0 8px 20px rgba(79,70,229,0.4);
    }
    .item-row {
      background: #f8fafc;
      margin: 12px 0;
      padding: 14px 18px;
      border-radius: 28px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: all 0.3s;
    }
    .item-row:hover {
      background: #eef2ff;
      transform: translateX(5px);
    }
    .student-card {
      display: flex;
      align-items: center;
      gap: 16px;
      background: #f1f5f9;
      margin-bottom: 12px;
      padding: 14px;
      border-radius: 32px;
      transition: all 0.3s;
    }
    .student-card:hover {
      background: #e2e8f0;
      transform: translateX(5px);
    }
    .student-avatar {
      width: 56px;
      height: 56px;
      background: linear-gradient(145deg, #818cf8, #c084fc);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      animation: float 2s ease-in-out infinite;
    }
    .idcard-preview {
      background: linear-gradient(135deg, #fef9c3, #fef08a);
      padding: 20px;
      border-radius: 32px;
      margin-top: 16px;
      border: 1px solid #eab308;
      animation: slideInRight 0.5s ease-out;
    }
    iframe {
      border-radius: 24px;
      width: 100%;
      height: 200px;
      transition: all 0.3s;
    }
    iframe:hover {
      transform: scale(1.02);
    }
    @media (max-width: 700px) {
      .dashboard-container { padding: 16px; }
      .glass-card { padding: 20px; }
    }
  </style>
</head>
<body id="app-root"></body>

<script>
  // ==================== MA'LUMOTLAR BAZASI (TO'LIQ OFFLINE) ====================
  function initDatabase() {
    if (!localStorage.getItem('eduai_full_db_v2')) {
      const defaultDB = {
        users: [
          { id: 1001, username: 'admin', password: 'admin123', role: 'Admin', fullname: 'Administrator', avatarEmoji: '👑', profilePic: null },
          { id: 1002, username: 'teacher', password: 'teacher123', role: 'Domla', fullname: 'Aziz Domla', avatarEmoji: '👨‍🏫', profilePic: null },
          { id: 1003, username: 'student', password: 'student123', role: 'Talaba', fullname: 'Jasur Talabayev', avatarEmoji: '🧑‍🎓', profilePic: null }
        ],
        lessons: [
          { id: 'l1', title: 'Sunʼiy intellekt asoslari', videoUrl: 'https://www.youtube.com/embed/2ePf9rue1Ao', ebookUrl: 'https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf' },
          { id: 'l2', title: 'Web dasturlash (React)', videoUrl: 'https://www.youtube.com/embed/Ke90Tje7VSY', ebookUrl: 'https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf' }
        ],
        tests: [
          { id: 't1', lessonId: 'l1', question: 'AI qisqartmasi nimani anglatadi?', options: ['Artificial Intelligence', 'Automatic Input', 'Algorithmic Idea'], answer: 'Artificial Intelligence' },
          { id: 't2', lessonId: 'l2', question: 'React komponentlari qaysi tilda yoziladi?', options: ['JSX', 'HTML', 'Python'], answer: 'JSX' }
        ],
        certificates: []
      };
      localStorage.setItem('eduai_full_db_v2', JSON.stringify(defaultDB));
    }
  }
  initDatabase();
  function getDB() { return JSON.parse(localStorage.getItem('eduai_full_db_v2')); }
  function saveDB(db) { localStorage.setItem('eduai_full_db_v2', JSON.stringify(db)); }

  let currentUser = JSON.parse(localStorage.getItem('eduai_current_session_v2')) || null;

  function render() {
    const root = document.getElementById('app-root');
    if (!currentUser) {
      root.innerHTML = renderLoginPage();
      attachLoginEvents();
      return;
    }
    if (currentUser.role === 'Admin') root.innerHTML = renderAdminPanel();
    else if (currentUser.role === 'Domla') root.innerHTML = renderTeacherPanel();
    else if (currentUser.role === 'Talaba') root.innerHTML = renderStudentPanel();
    else root.innerHTML = '<div class="dashboard-container">Xatolik</div>';
    attachCommonEvents();
  }

  function renderLoginPage() {
    return `
      <div class="login-page">
        <div class="login-card">
          <h2><i class="fas fa-graduation-cap"></i> EduAI</h2>
          <input type="text" id="loginUsername" placeholder="Login" autocomplete="off" />
          <input type="password" id="loginPassword" placeholder="Parol" />
          <button id="doLoginBtn"><i class="fas fa-arrow-right"></i> Kirish</button>
          <div class="demo-info">
            <i class="fas fa-info-circle"></i> <strong>Demo ma'lumotlar:</strong><br>
            👑 Admin: admin / admin123 &nbsp;|&nbsp; 👨‍🏫 Domla: teacher / teacher123<br>
            🧑‍🎓 Talaba: student / student123
          </div>
        </div>
      </div>
    `;
  }

  function attachLoginEvents() {
    document.getElementById('doLoginBtn')?.addEventListener('click', () => {
      const uname = document.getElementById('loginUsername').value.trim();
      const pwd = document.getElementById('loginPassword').value.trim();
      const db = getDB();
      const user = db.users.find(u => u.username === uname && u.password === pwd);
      if (user) {
        currentUser = { ...user };
        localStorage.setItem('eduai_current_session_v2', JSON.stringify(currentUser));
        render();
      } else alert('Login yoki parol noto‘g‘ri!');
    });
  }

  // ==================== ADMIN PANEL ====================
  function renderAdminPanel() {
    const db = getDB();
    return `
      <div class="dashboard-container">
        <div class="top-bar"><div class="logo"><i class="fas fa-crown"></i> EduAI Admin</div><div class="user-area"><span>${currentUser.fullname}</span><div class="avatar-icon">👑</div><button class="logout-btn" id="logoutBtn"><i class="fas fa-sign-out-alt"></i> Chiqish</button></div></div>
        <div class="tabs"><button class="tab-btn active" data-tab="students">📚 Talabalar</button><button class="tab-btn" data-tab="teachers">👨‍🏫 Domlalar</button><button class="tab-btn" data-tab="lessons">📖 Darslar</button><button class="tab-btn" data-tab="tests">📝 Testlar</button><button class="tab-btn" data-tab="certificates">🎓 Sertifikatlar</button></div>
        <div id="adminDynamicContent">${renderAdminStudentsTab(db.users.filter(u=>u.role==='Talaba'))}</div>
      </div>
    `;
  }

  function renderAdminStudentsTab(students) {
    return `<div class="grid-2cols"><div class="glass-card"><h3><i class="fas fa-user-plus"></i> Yangi talaba</h3><input id="newStFull" placeholder="To‘liq ism"/><input id="newStLogin" placeholder="Login"/><input type="password" id="newStPass" placeholder="Parol"/><input id="newStEmoji" placeholder="Avatar emoji" value="🧑‍🎓"/><button class="primary" id="addStudentBtn">➕ Qo‘shish</button></div><div class="glass-card"><h3><i class="fas fa-id-card"></i> Talabalar & ID Card</h3><div id="studentsList">${students.map(s=>`<div class="student-card"><div class="student-avatar">${s.avatarEmoji||'🧑‍🎓'}</div><div><strong>${s.fullname}</strong><br>${s.username}</div><button class="primary viewIdBtn" data-id="${s.id}" style="padding:6px 12px;">🆔 ID</button><button class="primary giveCertBtn" data-name="${s.fullname}" data-id="${s.id}" style="background:#10b981;">🎖️ Sertifikat</button></div><div id="idCard_${s.id}" style="display:none;" class="idcard-preview"><img src="https://randomuser.me/api/portraits/lego/${s.id%50}.jpg" width="60" style="border-radius:50%"><br><b>${s.fullname}</b><br>ID: ${s.id}<br><button onclick="closeCard(${s.id})">Yopish</button></div>`).join('')}</div></div></div>`;
  }

  window.closeCard = (id) => { document.getElementById(`idCard_${id}`).style.display = 'none'; };

  function attachAdminEvents() {
    document.getElementById('addStudentBtn')?.addEventListener('click',()=>{
      const full=document.getElementById('newStFull').value, uname=document.getElementById('newStLogin').value, pwd=document.getElementById('newStPass').value, emoji=document.getElementById('newStEmoji').value;
      if(!full||!uname||!pwd) return alert("To‘ldiring!");
      const db=getDB();
      if(db.users.find(u=>u.username===uname)) return alert("Mavjud!");
      db.users.push({id:Date.now(),username:uname,password:pwd,role:'Talaba',fullname:full,avatarEmoji:emoji});
      saveDB(db); render();
    });
    document.getElementById('addTeacherAdminBtn')?.addEventListener('click',()=>{
      const full=document.getElementById('teacherFull')?.value, uname=document.getElementById('teacherLogin')?.value, pwd=document.getElementById('teacherPass')?.value;
      if(full&&uname&&pwd){const db=getDB(); db.users.push({id:Date.now(),username:uname,password:pwd,role:'Domla',fullname:full,avatarEmoji:'👨‍🏫'}); saveDB(db); render();}
    });
    document.getElementById('addLessonAdminBtn')?.addEventListener('click',()=>{
      const title=document.getElementById('lessonTitle')?.value, video=document.getElementById('lessonVideo')?.value, ebook=document.getElementById('lessonEbook')?.value;
      if(title){const db=getDB(); db.lessons.push({id:'l'+Date.now(),title,videoUrl:video,ebookUrl:ebook}); saveDB(db); render();}
    });
    document.getElementById('addTestAdminBtn')?.addEventListener('click',()=>{
      const lessonId=document.getElementById('testLessonSelect')?.value, q=document.getElementById('testQuestion')?.value, a=document.getElementById('correctAnswer')?.value, optA=document.getElementById('optA')?.value, optB=document.getElementById('optB')?.value;
      if(q&&a){const db=getDB(); db.tests.push({id:'t'+Date.now(),lessonId,question:q,options:[optA,optB],answer:a}); saveDB(db); render();}
    });
    document.querySelectorAll('.giveCertBtn').forEach(btn=>{
      btn.onclick=()=>{const db=getDB(); const exists=db.certificates.find(c=>c.studentId==btn.dataset.id); if(!exists){db.certificates.push({studentId:Number(btn.dataset.id),studentName:btn.dataset.name,date:new Date().toLocaleDateString('uz-UZ'),certCode:'EDU-'+Math.random().toString(36).substr(2,8).toUpperCase()}); saveDB(db); alert("Sertifikat berildi!"); render();} else alert("Oldin berilgan!");};
    });
    document.querySelectorAll('.viewIdBtn').forEach(btn=>{btn.onclick=()=>{document.getElementById(`idCard_${btn.dataset.id}`).style.display='block';};});
  }

  // ==================== DOMLA PANEL ====================
  function renderTeacherPanel() {
    const db=getDB();
    return `<div class="dashboard-container"><div class="top-bar"><div class="logo">🧑‍🏫 Domla paneli</div><button class="logout-btn" id="logoutTeachBtn">Chiqish</button></div><div class="grid-2cols"><div class="glass-card"><h3>📹 Video qo‘shish</h3><input id="videoTitle" placeholder="Nomi"/><input id="videoLink" placeholder="YouTube URL"/><button id="addVideoBtn" class="primary">Qo‘shish</button></div><div class="glass-card"><h3>📘 Elektron kitob</h3><input id="ebookTitle" placeholder="Kitob nomi"/><input id="ebookLink" placeholder="PDF URL"/><button id="addEbookBtn" class="primary">Qo‘shish</button></div><div class="glass-card"><h3>📖 Darslar</h3>${db.lessons.map(l=>`<div class="item-row"><b>${l.title}</b> <a href="${l.videoUrl}" target="_blank">🎥 Video</a> | <a href="${l.ebookUrl}" target="_blank">📘 Kitob</a></div>`).join('')}</div></div></div>`;
  }

  // ==================== TALABA PANEL ====================
  function renderStudentPanel() {
    const db=getDB();
    const myCerts=db.certificates.filter(c=>c.studentId===currentUser.id);
    return `<div class="dashboard-container"><div class="top-bar"><div class="logo">🎓 ${currentUser.fullname}</div><div class="user-area"><div class="avatar-icon">${currentUser.avatarEmoji||'🧑‍🎓'}</div><button class="logout-btn" id="logoutStudentBtn">Chiqish</button></div></div><div class="tabs"><button class="tab-btn active" data-tab="profile">🆔 Profil & ID</button><button class="tab-btn" data-tab="materials">📚 Darslar</button><button class="tab-btn" data-tab="tests">📝 Testlar</button><button class="tab-btn" data-tab="mycert">🏅 Sertifikatlar</button></div><div id="studentDynamicContent">${renderStudentProfileTab(currentUser)}</div></div>`;
  }

  function renderStudentProfileTab(user) {
    return `<div class="grid-2cols"><div class="glass-card"><h3>🖼️ Profil rasmi</h3><div style="display:flex;gap:16px;"><div class="avatar-icon" style="font-size:42px;">${user.avatarEmoji||'🧑‍🎓'}</div><input id="newAvatar" placeholder="Emoji" value="${user.avatarEmoji||''}"/><button id="updateAvatarBtn" class="primary">Yangilash</button></div><hr><div class="idcard-preview"><i class="fas fa-id-card"></i> <strong>ID KARTA</strong><br><img src="https://randomuser.me/api/portraits/men/${user.id%70}.jpg" width="60"><br><b>${user.fullname}</b><br>Login: ${user.username}<br>ID: ${user.id}</div></div></div>`;
  }

  function attachStudentEvents() {
    document.getElementById('updateAvatarBtn')?.addEventListener('click',()=>{
      const newEmoji=document.getElementById('newAvatar')?.value;
      if(newEmoji){currentUser.avatarEmoji=newEmoji; const db=getDB(); const idx=db.users.findIndex(u=>u.id===currentUser.id); if(idx!==-1) db.users[idx].avatarEmoji=newEmoji; saveDB(db); localStorage.setItem('eduai_current_session_v2',JSON.stringify(currentUser)); render();}
    });
    document.querySelectorAll('.testOptBtn').forEach(btn=>{
      btn.onclick=()=>{const qid=btn.dataset.qid, selected=btn.dataset.ans, db=getDB(), test=db.tests.find(t=>t.id===qid); if(test&&test.answer===selected) document.getElementById(`testRes_${qid}`).innerHTML='<span style="color:green;">✅ To‘g‘ri</span>'; else document.getElementById(`testRes_${qid}`).innerHTML='<span style="color:red;">❌ Xato</span>';};
    });
  }

  function attachCommonEvents() {
    document.getElementById('logoutBtn')?.addEventListener('click',()=>{localStorage.removeItem('eduai_current_session_v2'); currentUser=null; render();});
    document.getElementById('logoutTeachBtn')?.addEventListener('click',()=>{localStorage.removeItem('eduai_current_session_v2'); currentUser=null; render();});
    document.getElementById('logoutStudentBtn')?.addEventListener('click',()=>{localStorage.removeItem('eduai_current_session_v2'); currentUser=null; render();});
    // Admin tab navigation
    const tabs=document.querySelectorAll('.tab-btn');
    tabs.forEach(btn=>{
      btn.onclick=()=>{
        if(!document.getElementById('adminDynamicContent')) return;
        tabs.forEach(t=>t.classList.remove('active'));
        btn.classList.add('active');
        const db=getDB();
        const container=document.getElementById('adminDynamicContent');
        if(btn.dataset.tab==='students') container.innerHTML=renderAdminStudentsTab(db.users.filter(u=>u.role==='Talaba'));
        if(btn.dataset.tab==='teachers') container.innerHTML=renderAdminTeachersTab(db.users.filter(u=>u.role==='Domla'));
        if(btn.dataset.tab==='lessons') container.innerHTML=renderAdminLessonsTab(db);
        if(btn.dataset.tab==='tests') container.innerHTML=renderAdminTestsTab(db);
        if(btn.dataset.tab==='certificates') container.innerHTML=renderAdminCertificatesTab(db);
        attachAdminEvents();
      };
    });
    // Student tab navigation
    const studentTabs=document.querySelectorAll('[data-tab]');
    studentTabs.forEach(btn=>{
      if(btn.dataset.tab && document.getElementById('studentDynamicContent')){
        btn.onclick=()=>{
          studentTabs.forEach(t=>t.classList.remove('active'));
          btn.classList.add('active');
          const db=getDB();
          const container=document.getElementById('studentDynamicContent');
          if(btn.dataset.tab==='profile') container.innerHTML=renderStudentProfileTab(currentUser);
          if(btn.dataset.tab==='materials') container.innerHTML=`<div class="grid-2cols">${db.lessons.map(l=>`<div class="glass-card"><h3>${l.title}</h3><iframe src="${l.videoUrl}"></iframe><a href="${l.ebookUrl}" target="_blank" class="primary" style="display:inline-block;margin-top:12px;">📘 Kitob</a></div>`).join('')}</div>`;
          if(btn.dataset.tab==='tests') container.innerHTML=`<div class="glass-card"><h3>Testlar</h3>${db.tests.map(t=>`<div><b>${t.question}</b><br>${t.options.map(opt=>`<button class="primary testOptBtn" data-qid="${t.id}" data-ans="${opt}" style="margin:5px;">${opt}</button>`).join('')}<span id="testRes_${t.id}"></span></div><hr>`).join('')}</div>`;
          if(btn.dataset.tab==='mycert') {const certs=db.certificates.filter(c=>c.studentId===currentUser.id); container.innerHTML=`<div class="glass-card"><h3>Sertifikatlar</h3>${certs.map(c=>`<div class="item-row"><i class="fas fa-award"></i> ${c.date} | ${c.certCode}</div>`).join('')}</div>`;}
          attachStudentEvents();
        };
      }
    });
    attachAdminEvents();
    attachStudentEvents();
    document.getElementById('addVideoBtn')?.addEventListener('click',()=>alert('Video qo‘shildi (simulyatsiya)'));
    document.getElementById('addEbookBtn')?.addEventListener('click',()=>alert('Kitob qo‘shildi (simulyatsiya)'));
  }

  function renderAdminTeachersTab(teachers){return `<div class="grid-2cols"><div class="glass-card"><h3>➕ Domla qo‘shish</h3><input id="teacherFull" placeholder="FIO"/><input id="teacherLogin" placeholder="Login"/><input type="password" id="teacherPass" placeholder="Parol"/><button id="addTeacherAdminBtn" class="primary">Qo‘shish</button></div><div class="glass-card"><h3>📋 Domlalar</h3>${teachers.map(t=>`<div class="item-row"><span>${t.fullname} (${t.username})</span><button class="deleteTeacherBtn" data-id="${t.id}" style="background:#ef4444; border:none; padding:6px 12px; border-radius:30px;">O‘chirish</button></div>`).join('')}</div></div>`;}
  function renderAdminLessonsTab(db){return `<div class="grid-2cols"><div class="glass-card"><h3>📹 Dars qo‘shish</h3><input id="lessonTitle" placeholder="Dars nomi"/><input id="lessonVideo" placeholder="Video URL"/><input id="lessonEbook" placeholder="E-kitob URL"/><button id="addLessonAdminBtn" class="primary">Yaratish</button></div><div class="glass-card"><h3>📚 Darslar</h3>${db.lessons.map(l=>`<div class="item-row"><b>${l.title}</b><button class="deleteLessonBtn" data-id="${l.id}" style="background:#ef4444;">🗑️</button></div>`).join('')}</div></div>`;}
  function renderAdminTestsTab(db){return `<div class="grid-2cols"><div class="glass-card"><h3>✍️ Test qo‘shish</h3><select id="testLessonSelect">${db.lessons.map(l=>`<option value="${l.id}">${l.title}</option>`).join('')}</select><input id="testQuestion" placeholder="Savol"/><input id="optA" placeholder="Variant A"/><input id="optB" placeholder="Variant B"/><input id="correctAnswer" placeholder="To‘g‘ri javob"/><button id="addTestAdminBtn" class="primary">Qo‘shish</button></div><div class="glass-card"><h3>📋 Testlar</h3>${db.tests.map(t=>`<div class="item-row"><b>${t.question}</b><button class="deleteTestBtn" data-id="${t.id}" style="background:#ef4444;">O‘chirish</button></div>`).join('')}</div></div>`;}
  function renderAdminCertificatesTab(db){const students=db.users.filter(u=>u.role==='Talaba'); return `<div class="glass-card"><h3>🎓 Sertifikatlar</h3>${students.map(s=>`<div class="student-card"><div>${s.fullname}</div><button class="primary giveCertBtn" data-name="${s.fullname}" data-id="${s.id}" style="background:#10b981;">🎖️ Berish</button></div>`).join('')}<hr><h3>Berilganlar</h3>${db.certificates.map(c=>`<div class="item-row"><i class="fas fa-award"></i> ${c.studentName} - ${c.date}</div>`).join('')}</div>`;}

  render();
</script>
</html>